# ==============================================================================
# bokra (tracker-v2) - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to git or expose secrets in public repositories.
# ==============================================================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Authentication (Clerk)
# For production deployments, use live keys (pk_live_... and sk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Clerk Production Proxy (PRODUCTION ONLY on Vercel)
# DO NOT set in local development (.env / .env.local). Leaving it unset locally ensures
# Clerk SDK talks directly to its endpoints without triggering 400 Origin Mismatch errors.
# On Vercel production environment variables, set:
# NEXT_PUBLIC_CLERK_PROXY_URL="https://bokra101.vercel.app/__clerk"

# Desktop / Mobile App Bridge Secrets
# REQUIRED in production. If missing, all desktop tokens fail-closed.
# Generate a strong 256-bit secret using: openssl rand -hex 32
JWT_SECRET="generate_with_openssl_rand_hex_32"

# Background Automation & Cron Protection
CRON_SECRET="your_long_random_cron_secret_here"

# Spotify API Integration
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Distributed Rate Limiting (Upstash Redis - optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# Firebase Cloud Messaging (Web Push Notifications)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your_project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
