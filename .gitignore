*.dmg
public/*.dmg
*.apk
!public/bokra.apk
node_modules
bokra-android.zip
*.keystore
assetlinks.json
.next
dist
src-tauri/target/
.api_backup/
db_backup_*.json
tests/
audit-screenshots/
