datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. جدول المستخدمين ومربوط بـ Clerk
model User {
  id             String     @id // هنا هنخزن الـ clerkId الفريد
  email          String     @unique
  name           String?    @default("Zain")
  fcmToken       String?    // توكن الإشعارات لجهاز المستخدم
  theme          String     @default("dark")
  bgStyle        String     @default("aurora")
  lang           String     @default("en")
  themeColor     String     @default("#007AFF")
  emergencyCards Json?      @default("[]") // Custom emergency cards
  grantedCards   Json?      @default("{}") // The log of opened cards
  finishedTickets Json?     @default("[]") // History of finished flight tickets
  activeSessionType String? // "pomodoro" or "flight"
  activeSessionData Json?   // Session details
  avatar         String?    @default("boy1") // boy1, boy2, boy3, girl1, girl2, girl3
  widgetPreferences Json?   @default("{\"mode\":\"default\",\"friends\":[],\"groups\":[]}")
  friendCode     String?    @unique // كود الصداقة المميز
  isAdmin        Boolean    @default(false)
  isBlocked      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  habits         Habit[]
  dailyLogs      DailyLog[]
  friendships    Friendship[] @relation("UserFriendships")
  friendRequests Friendship[] @relation("FriendRequests")
  groupMembers   GroupMember[]
  challengeParticipants ChallengeParticipant[]
}

// 2. جدول العادات ببيانات الإشعارات المخصصة بنظام 12 ساعة
model Habit {
  id              String   @id // هيفضل ياخد الـ id العشوائي اللي بنكريته في الواجهة
  name            String
  type            String   // "single" أو "multi"
  subItems        String[] // خانات الـ checklist
  
  isNotifyEnabled Boolean  @default(false)
  notifyTime      String?  // هيتخزن بصيغة "08:00 PM"
  customMessage   String?  // رسالة المنبه الخاصة بالعادة
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 3. جدول تسجيل العادات اليومي والإحصائيات
model DailyLog {
  id        String   @id @default(cuid())
  date      String   // بصيغة "YYYY-MM-DD"
  logs      Json     // هيخزن الـ state الكاملة للـ Checked عادات في اليوم ده
  tasks     Json?    @default("[]") // المهام المؤقتة لليوم ده (البومودورو والرحلات)
  sleep     String?  // ساعات النوم (كـ String أو Number)
  focusTime Int?     @default(0) // إجمالي ثواني التركيز
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // بيمنع تكرار نفس اليوم لنفس اليوزر
}

// 4. جدول الأصدقاء
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("PENDING") // PENDING أو ACCEPTED
  createdAt DateTime @default(now())

  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendRequests", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// 5. مجموعات المذاكرة (Study Groups)
model StudyGroup {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  
  members   GroupMember[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())

  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// 6. Shared Challenges (تحديات مشتركة)
model SharedChallenge {
  id          String   @id @default(cuid())
  name        String
  tasks       Json     // array of strings: ["Read 10 pages", "Workout"]
  createdAt   DateTime @default(now())
  deadline    DateTime?
  
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  progress    Json     @default("{}") // e.g. {"date-subitem": true}
  joinedAt    DateTime @default(now())

  challenge   SharedChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}