datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. جدول المستخدمين ومربوط بـ Clerk
model User {
  id             String     @id // هنا هنخزن الـ clerkId الفريد
  email          String     @unique
  name           String?    @default("Zain")
  fcmToken       String?    // توكن الإشعارات لجهاز المستخدم
  theme          String     @default("dark")
  bgStyle        String     @default("aurora")
  lang           String     @default("en")
  themeColor     String     @default("#007AFF")
  emergencyCards Json?      @default("[]") // Custom emergency cards
  grantedCards   Json?      @default("{}") // The log of opened cards
  finishedTickets Json?     @default("[]") // History of finished flight tickets
  activeSessionType String? // "pomodoro" or "flight"
  activeSessionData Json?   // Session details
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  habits         Habit[]
  dailyLogs      DailyLog[]
}

// 2. جدول العادات ببيانات الإشعارات المخصصة بنظام 12 ساعة
model Habit {
  id              String   @id // هيفضل ياخد الـ id العشوائي اللي بنكريته في الواجهة
  name            String
  type            String   // "single" أو "multi"
  subItems        String[] // خانات الـ checklist
  
  isNotifyEnabled Boolean  @default(false)
  notifyTime      String?  // هيتخزن بصيغة "08:00 PM"
  customMessage   String?  // رسالة المنبه الخاصة بالعادة
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 3. جدول تسجيل العادات اليومي والإحصائيات
model DailyLog {
  id        String   @id @default(cuid())
  date      String   // بصيغة "YYYY-MM-DD"
  logs      Json     // هيخزن الـ state الكاملة للـ Checked عادات في اليوم ده
  tasks     Json?    @default("[]") // المهام المؤقتة لليوم ده (البومودورو والرحلات)
  sleep     String?  // ساعات النوم (كـ String أو Number)
  focusTime Int?     @default(0) // إجمالي ثواني التركيز
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // بيمنع تكرار نفس اليوم لنفس اليوزر
}