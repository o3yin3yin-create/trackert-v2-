datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. جدول المستخدمين ومربوط بـ Clerk
model User {
  id             String     @id @default(cuid())
  clerkId        String     @unique // معرف Clerk الفريد للحساب
  email          String     @unique
  username       String?    @unique // اسم المستخدم الفريد لنظام الأصدقاء
  name           String?    @default("Zain")
  fcmToken       String?    // توكن الإشعارات لجهاز المستخدم
  theme          String     @default("dark")
  bgStyle        String     @default("aurora")
  lang           String     @default("en")
  themeColor     String     @default("#007AFF")
  emergencyCards Json?      @default("[]") // Custom emergency cards
  grantedCards   Json?      @default("{}") // The log of opened cards
  finishedTickets Json?     @default("[]") // History of finished flight tickets
  activeSessionType String? // "pomodoro" or "flight"
  activeSessionData Json?   // Session details
  avatar         String?    @default("boy1") // boy1, boy2, boy3, girl1, girl2, girl3
  spotifyRefreshToken String? // توكن سبوتيفاي للمزامنة بين الويب والديسكتوب
  isAdmin        Boolean    @default(false)
  isBlocked      Boolean    @default(false)
  notifications  Json?      @default("[]") // In-app notifications (requests, nudges, cheers)
  privacySettings Json?     @default("{}") // إعدادات الخصوصية للأصدقاء
  timezone       String?    @default("Africa/Cairo") // المنطقة الزمنية لحساب الوقت بدقة
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  habits           Habit[]
  dailyLogs        DailyLog[]
  sentRequests     Friendship[] @relation("FriendRequester")
  receivedRequests Friendship[] @relation("FriendAddressee")
}

// 2. جدول العادات ببيانات المواعيد المجدولة والتفاصيل الإضافية (الوقت والمكان)
model Habit {
  id              String   @id // هيفضل ياخد الـ id العشوائي اللي بنكريته في الواجهة
  name            String
  type            String   // "single" أو "multi"
  subItems        String[] // خانات الـ checklist
  
  frequency       String   @default("daily") // "daily" أو "once" أو "weekly" أو "monthly" أو "yearly"
  scheduleDays    Int[]    @default([])      // أيام الأسبوع [0..6] (0=الأحد)
  scheduleDate    String?                    // لتاريخ "once" كـ "YYYY-MM-DD" أو لليوم الشهري ("1".."31") أو السنوي ("MM-DD")
  
  time            String?  // ميعاد العادة الاختياري مثل "04:00 PM"
  duration        String?  // مدة العادة مثل "2h" أو "45m"
  location        String?  // مكان العادة الاختياري مثل "قاعة 302" أو "الجيم"
  category        String?  @default("habit") // نوع العادة: lecture, meeting, exam, study, workout, habit
  isPrivate       Boolean  @default(false)   // إذا كانت العادة خاصة لا تظهر للأصدقاء
  
  isNotifyEnabled Boolean  @default(false)
  notifyTime      String?  // هيتخزن بصيغة "08:00 PM"
  notifyBefore    Int?     @default(0)       // التنبيه قبلها بقد إيه بالدقائق: 0, 10, 30, 60, 1440
  customMessage   String?  // رسالة المنبه الخاصة بالعادة
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 3. جدول تسجيل العادات اليومي والإحصائيات
model DailyLog {
  id        String   @id @default(cuid())
  date      String   // بصيغة "YYYY-MM-DD"
  logs      Json     // هيخزن الـ state الكاملة للـ Checked عادات في اليوم ده
  tasks     Json?    @default("[]") // المهام المؤقتة لليوم ده (البومودورو والرحلات)
  sleep     String?  // ساعات النوم (كـ String أو Number)
  focusTime Int?     @default(0) // إجمالي ثواني التركيز
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // بيمنع تكرار نفس اليوم لنفس اليوزر
}

// 4. جدول الصداقات
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted | blocked
  togetherSeconds Int  @default(0)         // ثواني التركيز والمذاكرة المشتركة
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
